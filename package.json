{
  "name": "@dsh-external/dsh-client-ui-git",
  "description": "Git visualizer for the dsh web GUI: branch/commit graph, working-tree status, and commit diff browser (read-only). Host half runs git via child_process; browser half renders a sidebar panel.",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "locale/*.json"
  ]
}
